{
  "name": "e-audit-platform",
  "version": "1.0.0",
  "description": "AI-Powered Technical Assessment Platform",
  "type": "module",
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "scripts": {
    "dev": "tsx src/server/server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm install && npm run build",
    "build:server": "npx tsc",
    "start": "node dist/server/server.js",
    "pretest": "npm run build:server",
    "test": "node --test",
    "test:postgres": "npm run build:server && node scripts/run-postgres-tests.mjs",
    "test:ai-grade:real": "node scripts/verify-ai-grade-real-provider.mjs",
    "local:up": "docker compose -f docker-compose.local.yml up --build --detach --wait",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:logs": "docker compose -f docker-compose.local.yml logs --follow app database",
    "test:local": "node scripts/run-local-compose-tests.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@google/generative-ai": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "groq": "^5.20.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.34.0",
    "pg": "^8.11.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.9",
    "esbuild": "^0.28.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
