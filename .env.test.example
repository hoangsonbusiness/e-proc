# Copy this file to .env.test.local and replace the whole value with the
# Transaction Pooler connection string from a NON-PRODUCTION Supabase project.
# Never commit .env.test.local.
TEST_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Generate once (for example: openssl rand -base64 32) and use the same value
# in every backend deployment that must decrypt stored user LLM keys.
AI_SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_OR_64_HEX
